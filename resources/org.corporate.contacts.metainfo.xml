  <url type="bugtracker">https://github.com/daniilsukhanoff-hub/corporate-contacts/issues</url>
  <url type="vcs-browser">https://github.com/daniilsukhanoff-hub/corporate-contacts</url>
  <content_rating type="oars-1.1"/>
  <provides>
    <binary>corporate-contacts</binary>
  </provides>
</component>
