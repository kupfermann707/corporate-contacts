<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.corporate.contacts.desktop</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Справочник контактов</name>
  <summary>Корпоративный телефонный справочник</summary>
  <description>
    <p>
      Нативное приложение для поиска и управления корпоративными контактами организации.
    </p>
    <ul>
      <li>Мгновенный поиск по ФИО, должности, отделу, телефону, почте и кабинету</li>
      <li>Фильтрация по филиалам, локациям и отделам</li>
      <li>Копирование телефонных номеров и email в один клик</li>
      <li>Быстрый запуск почтового клиента</li>
      <li>Добавление, редактирование и удаление контактов</li>
      <li>Импорт базы из CSV файлов любого формата с автоопределением полей</li>
      <li>Встроенный веб-сервер для доступа по локальной сети (LAN)</li>
      <li>Экспорт базы в формат CSV</li>
    </ul>
  </description>
  <launchable type="desktop-id">org.corporate.contacts.desktop</launchable>
  <developer id="daniilsukhanoff-hub">
    <name>Даниил Суханов (daniilsukhanoff-hub)</name>
  </developer>
