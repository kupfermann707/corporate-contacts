#!/bin/sh
set -e

if [ "$1" = "remove" ] || [ "$1" = "deconfigure" ]; then
    # Завершаем только бинарный процесс приложения (точное совпадение имени процесса),
    # чтобы случайно не завершить dpkg/apt, у которых имя пакета присутствует в аргументах
    pkill -x corporate-contacts 2>/dev/null || true
fi

exit 0
