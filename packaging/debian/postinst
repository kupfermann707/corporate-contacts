#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    # Если это чистая установка с нуля (не обновление с предыдущей версии, $2 пустое),
    # гарантируем очистку любых старых остаточных файлов данных из предыдущих сессий
    if [ -z "$2" ]; then
        if which getent >/dev/null 2>&1; then
            getent passwd | awk -F: '$3 >= 1000 || $3 == 0 { print $6 }' | while read -r user_home; do
                if [ -n "$user_home" ] && [ -d "$user_home" ]; then
                    rm -f "$user_home/.local/share/corporate-contacts/data.json" 2>/dev/null || true
                fi
            done
        fi
        for user_home in /home/* /root; do
            if [ -d "$user_home" ]; then
                rm -f "$user_home/.local/share/corporate-contacts/data.json" 2>/dev/null || true
            fi
        done
    fi

    # Обновление кэшей окружения рабочего стола
    if which update-desktop-database >/dev/null 2>&1; then
        update-desktop-database -q /usr/share/applications || true
    fi
    if which gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
    fi
    if which appstreamcli >/dev/null 2>&1; then
        appstreamcli refresh-cache --force >/dev/null 2>&1 || true
    fi

    # Создание директории журнала аудита 152-ФЗ
    mkdir -p /var/log/corporate-contacts
    chmod 0755 /var/log/corporate-contacts 2>/dev/null || true
fi

exit 0
